<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= pageTitle ? pageTitle + ' — ' : '' %><%= companyName %> Görev Takip</title>

  <!--
    Tailwind CSS "Play CDN" kullanılıyor: derleme adımı gerektirmez, projeyi
    klonlayıp tek komutla çalıştırma hedefini korur. Kurulum sırasında internet
    erişimi gerekir. Tamamen çevrimdışı bir kurulum isterseniz README'deki
    "Tailwind'i yerelleştirme" bölümüne bakın.
  -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Kurumsal palet: nötr slate + güven veren indigo + çay için amber vurgu.
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50:  '#eef2ff', 100: '#e0e7ff', 200: '#c7d2fe', 300: '#a5b4fc',
              400: '#818cf8', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca',
              800: '#3730a3', 900: '#312e81',
            },
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>">
</head>
<body class="bg-slate-100 text-slate-800 antialiased">
