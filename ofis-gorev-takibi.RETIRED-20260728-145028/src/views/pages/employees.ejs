<%- include('../partials/layout-start') %>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

  <!-- ================= FORM (ekle / düzenle) ================= -->
  <div class="lg:col-span-1">
    <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold text-slate-900">
          <%= editing ? 'Personeli Düzenle' : 'Yeni Personel Ekle' %>
        </h2>
        <% if (!editing) { %>
          <p class="mt-0.5 text-xs text-slate-500">Görev sırasındaki yerini aşağıdan seçebilirsiniz.</p>
        <% } %>
      </div>

      <!-- Doğrulama hataları -->
      <% if (formErrors.length > 0) { %>
        <div class="mx-5 mt-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5">
          <ul class="space-y-1 text-xs text-rose-700">
            <% formErrors.forEach((error) => { %>
              <li>• <%= error %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form method="POST"
            action="<%= editing ? '/personeller/' + editing.id : '/personeller' %>"
            class="space-y-4 p-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Ad soyad -->
        <div>
          <label for="full_name" class="mb-1.5 block text-xs font-medium text-slate-700">
            Ad Soyad <span class="text-rose-500">*</span>
          </label>
          <input type="text" id="full_name" name="full_name" required maxlength="100"
                 value="<%= formValues.full_name || '' %>"
                 placeholder="Beril Kahramanca"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
        </div>

        <!-- Discord ID -->
        <div>
          <label for="discord_user_id" class="mb-1.5 block text-xs font-medium text-slate-700">
            Discord Kullanıcı ID
          </label>
          <input type="text" id="discord_user_id" name="discord_user_id"
                 inputmode="numeric" pattern="\d*" maxlength="20"
                 value="<%= formValues.discord_user_id || '' %>"
                 placeholder="123456789012345678"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
          <p class="mt-1.5 text-[11px] leading-relaxed text-slate-500">
            <span class="font-medium">Günlük hatırlatmalar bu ID üzerinden özel mesajla gönderilir</span>;
            girilmezse kişi görev günlerinde hatırlatma alamaz (kanaldaki onay akışı yine çalışır).
            Discord'da <span class="font-medium">Ayarlar → Gelişmiş → Geliştirici Modu</span>'nu açıp
            kullanıcıya sağ tıklayarak "Kullanıcı ID'sini Kopyala" ile alabilirsiniz.
          </p>
        </div>

        <!-- Sıraya ekleme konumu (yalnızca yeni kayıtta; düzenlemede sıra
             görev sırası sayfasından yönetilir) -->
        <% if (!editing) { %>
          <div>
            <label for="position" class="mb-1.5 block text-xs font-medium text-slate-700">
              Görev Sırası
            </label>
            <select id="position" name="position"
                    class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
              <%# Her mevcut kişinin ÖNÜNE ekleme seçeneği + sona ekleme (varsayılan). %>
              <% employees.forEach((employee, index) => { %>
                <option value="<%= index + 1 %>" <%= String(formValues.position) === String(index + 1) ? 'selected' : '' %>>
                  <%= index + 1 %>. sıra — <%= employee.full_name %> kişisinin önüne
                </option>
              <% }); %>
              <option value="" <%= formValues.position ? '' : 'selected' %>>
                <%= employees.length + 1 %>. sıra — en sona ekle (varsayılan)
              </option>
            </select>
            <p class="mt-1.5 text-[11px] leading-relaxed text-slate-500">
              Seçilen konumdan sonraki personellerin sırası otomatik olarak bir basamak kaydırılır.
              Sırayı sonradan <a href="/gorev-sirasi" class="font-medium text-brand-600 hover:underline">Görev Sırası</a>
              sayfasından da değiştirebilirsiniz.
            </p>
          </div>
        <% } %>

        <!-- Aktiflik -->
        <div class="flex items-start gap-2.5 rounded-lg bg-slate-50 p-3">
          <input type="checkbox" id="is_active" name="is_active"
                 <%= formValues.is_active ? 'checked' : '' %>
                 class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500">
          <label for="is_active" class="text-xs text-slate-700">
            <span class="font-medium">Aktif</span>
            <span class="mt-0.5 block text-slate-500">Pasif çalışanlar görev sırasından otomatik olarak çıkarılır (izinli personel için de bu seçeneği kaldırın).</span>
          </label>
        </div>

        <!-- Eylemler -->
        <div class="flex gap-2 pt-1">
          <button type="submit"
                  class="flex-1 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
            <%= editing ? 'Değişiklikleri Kaydet' : 'Personel Ekle' %>
          </button>
          <% if (editing) { %>
            <a href="/personeller"
               class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
              İptal
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= LİSTE ================= -->
  <div class="lg:col-span-2">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Personel Listesi</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            Adına tıklayarak düzenleyebilir, Discord ID'yi doğrudan tablodan yazıp Enter'a basabilirsiniz.
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600">
            Toplam <%= counts.total %>
          </span>
          <span class="rounded-full bg-emerald-100 px-2.5 py-1 font-medium text-emerald-700">
            Aktif <%= counts.active %>
          </span>
        </div>
      </div>

      <% if (employees.length === 0) { %>
        <div class="px-5 py-16 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <p class="mt-3 text-sm font-medium text-slate-900">Henüz personel yok</p>
          <p class="mt-1 text-xs text-slate-500">Soldaki formu kullanarak ilk çalışanı ekleyin.</p>
        </div>
      <% } else { %>

        <!-- Masaüstü: tablo -->
        <div class="hidden overflow-x-auto sm:block">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th scope="col" class="w-12 px-5 py-3 font-semibold">Sıra</th>
                <th scope="col" class="px-3 py-3 font-semibold">Ad Soyad</th>
                <th scope="col" class="px-3 py-3 font-semibold">Discord ID</th>
                <th scope="col" class="px-3 py-3 font-semibold">Durum</th>
                <th scope="col" class="px-5 py-3 text-right font-semibold">İşlemler</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% employees.forEach((employee, index) => { %>
                <tr class="transition hover:bg-slate-50 <%= employee.is_active ? '' : 'bg-slate-50/50' %>">
                  <td class="px-5 py-3 text-xs font-medium text-slate-400"><%= index + 1 %></td>

                  <td class="px-3 py-3">
                    <div class="flex items-center gap-2.5">
                      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full <%= employee.is_active ? avatarColor(employee.full_name) : 'bg-slate-300' %> text-[10px] font-bold text-white">
                        <%= initials(employee.full_name) %>
                      </div>
                      <%# Ad tıklanabilir: düzenleme sayfasına en kısa yol. %>
                      <a href="/personeller/<%= employee.id %>/duzenle"
                         class="font-medium text-slate-800 underline-offset-2 hover:text-brand-600 hover:underline <%= employee.is_active ? '' : 'text-slate-500' %>"
                         title="<%= employee.full_name %> — adını ve bilgilerini düzenle">
                        <%= employee.full_name %>
                      </a>
                    </div>
                  </td>

                  <%#
                    Discord ID doğrudan listede düzenlenir: 20+ kişiye ID girerken
                    her seferinde düzenleme sayfasına gidip dönmek gerekmesin.
                    Enter'a basmak yeterli (tek alanlı form kendiliğinden gönderilir).
                  %>
                  <td class="px-3 py-3">
                    <form method="POST" action="/personeller/<%= employee.id %>/discord-id"
                          class="flex items-center gap-1.5">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="redirectTo" value="/personeller">
                      <label class="sr-only" for="did-<%= employee.id %>"><%= employee.full_name %> Discord ID</label>
                      <input type="text" id="did-<%= employee.id %>" name="discord_user_id"
                             value="<%= employee.discord_user_id || '' %>"
                             inputmode="numeric" pattern="\d*" maxlength="20"
                             placeholder="ID yapıştırın"
                             class="w-44 rounded-md border px-2 py-1 font-mono text-xs outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 <%= employee.discord_user_id ? 'border-slate-300 text-slate-700' : 'border-dashed border-slate-300 text-slate-500' %>"
                             title="Discord kullanıcı ID'sini yapıştırıp Enter'a basın">
                      <button type="submit"
                              class="rounded-md p-1 text-slate-400 transition hover:bg-brand-50 hover:text-brand-600"
                              title="Discord ID'yi kaydet" aria-label="Discord ID'yi kaydet">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      </button>
                    </form>
                    <% if (employee.discord_user_id) { %>
                      <span class="mt-0.5 block text-[10px] text-emerald-600">✓ mesajlarda etiketlenir</span>
                    <% } %>
                  </td>

                  <td class="px-3 py-3">
                    <% if (employee.is_active) { %>
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Aktif
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span> Pasif
                      </span>
                    <% } %>
                  </td>

                  <td class="px-5 py-3">
                    <div class="flex items-center justify-end gap-1">
                      <!-- Aktif/pasif -->
                      <form method="POST" action="/personeller/<%= employee.id %>/durum">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="redirectTo" value="/personeller">
                        <button type="submit"
                                class="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                                title="<%= employee.is_active ? 'Pasife al' : 'Aktif yap' %>">
                          <% if (employee.is_active) { %>
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                          <% } else { %>
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                          <% } %>
                        </button>
                      </form>

                      <!-- Düzenle: ikon yerine etiketli buton (ad + ID değişikliği buradan) -->
                      <a href="/personeller/<%= employee.id %>/duzenle"
                         class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 px-2.5 py-1.5 text-xs font-medium text-slate-700 transition hover:border-brand-400 hover:bg-brand-50 hover:text-brand-700"
                         title="<%= employee.full_name %> — ad, Discord ID ve durumu düzenle">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        Düzenle
                      </a>

                      <!-- Sil -->
                      <form method="POST" action="/personeller/<%= employee.id %>/sil"
                            data-confirm="<%= employee.full_name %> silinecek. Görev geçmişindeki kayıtları korunur. Onaylıyor musunuz?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit"
                                class="rounded-md p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600"
                                title="Sil">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Mobil: kart listesi (tablo dar ekranda okunmaz) -->
        <ul class="divide-y divide-slate-100 sm:hidden">
          <% employees.forEach((employee, index) => { %>
            <li class="p-4 <%= employee.is_active ? '' : 'bg-slate-50/50' %>">
              <div class="flex items-start gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= employee.is_active ? avatarColor(employee.full_name) : 'bg-slate-300' %> text-[11px] font-bold text-white">
                  <%= initials(employee.full_name) %>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400"><%= index + 1 %>.</span>
                    <a href="/personeller/<%= employee.id %>/duzenle"
                       class="truncate text-sm font-medium text-slate-800 underline-offset-2 hover:text-brand-600 hover:underline">
                      <%= employee.full_name %>
                    </a>
                  </div>
                  <%# Mobilde de ID doğrudan girilebilsin. %>
                  <form method="POST" action="/personeller/<%= employee.id %>/discord-id" class="mt-1 flex items-center gap-1.5">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="redirectTo" value="/personeller">
                    <label class="sr-only" for="did-m-<%= employee.id %>"><%= employee.full_name %> Discord ID</label>
                    <input type="text" id="did-m-<%= employee.id %>" name="discord_user_id"
                           value="<%= employee.discord_user_id || '' %>"
                           inputmode="numeric" pattern="\d*" maxlength="20" placeholder="Discord ID"
                           class="w-40 rounded-md border px-2 py-1 font-mono text-[11px] outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 <%= employee.discord_user_id ? 'border-slate-300' : 'border-dashed border-slate-300' %>">
                    <button type="submit" class="rounded-md p-1 text-slate-400 hover:bg-brand-50 hover:text-brand-600" aria-label="Discord ID'yi kaydet">
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    </button>
                  </form>
                  <div class="mt-2 flex items-center gap-2">
                    <% if (employee.is_active) { %>
                      <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700">Aktif</span>
                    <% } else { %>
                      <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-medium text-slate-600">Pasif</span>
                    <% } %>
                  </div>
                </div>

                <div class="flex shrink-0 items-center gap-1">
                  <form method="POST" action="/personeller/<%= employee.id %>/durum">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="redirectTo" value="/personeller">
                    <button type="submit" class="rounded-md p-1.5 text-slate-400 hover:bg-slate-100" title="<%= employee.is_active ? 'Pasife al' : 'Aktif yap' %>">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </button>
                  </form>
                  <a href="/personeller/<%= employee.id %>/duzenle" class="rounded-md p-1.5 text-slate-400 hover:bg-slate-100" title="Düzenle">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </a>
                  <form method="POST" action="/personeller/<%= employee.id %>/sil"
                        data-confirm="<%= employee.full_name %> silinecek. Onaylıyor musunuz?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="rounded-md p-1.5 text-slate-400 hover:bg-rose-50 hover:text-rose-600" title="Sil">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
