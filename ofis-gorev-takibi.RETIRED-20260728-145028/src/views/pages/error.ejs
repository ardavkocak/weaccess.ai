<%- include('../partials/head') %>

<%
  /*
    Hata sayfası bilerek bağımsızdır (sol menü içermez): hata, oturum açılmadan
    veya CSRF/oturum katmanı çalışmadan önce de oluşabilir. Bu sayfanın
    `csrfToken` gibi değişkenlere ihtiyaç duymaması, hata sayfasının kendisinin
    hata vermesini engeller.
  */
%>
<div class="flex min-h-screen items-center justify-center bg-slate-100 px-4 py-12">
  <div class="w-full max-w-md text-center">

    <p class="text-6xl font-bold text-slate-300"><%= status %></p>

    <h1 class="mt-4 text-lg font-semibold text-slate-900">
      <%= status === 404 ? 'Sayfa Bulunamadı' : 'Bir Hata Oluştu' %>
    </h1>

    <p class="mt-2 text-sm text-slate-600"><%= message %></p>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/"
         class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
        Dashboard'a Dön
      </a>
      <button type="button" onclick="history.back()"
              class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
        Geri
      </button>
    </div>
  </div>
</div>

</body>
</html>
