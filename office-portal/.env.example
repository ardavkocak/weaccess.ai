SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Europe/Istanbul

# --- Zimmet Sistemi entegrasyonu (Faz 2) ---
# DIKKAT: Bu, zimmet-sistemi'nin KENDI veritabani degildir. Portal icin
# ayrilmis izole bir veritabanidir (bkz. config/settings.py docstring'i).
DB_NAME=office_portal_db
DB_USER=office_portal_user
DB_PASSWORD=office_portal_pass
DB_HOST=127.0.0.1
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Ofis Portali <noreply@ofisportali.local>
