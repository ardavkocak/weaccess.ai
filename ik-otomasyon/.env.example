# SMTP / E-posta ayarları
# Bu dosyayı kopyalayıp `.env` olarak kaydedin ve gerçek değerlerle doldurun.

# SMTP sunucusu adresi (ör. smtp.mailtrap.io veya smtp.gmail.com)
SMTP_HOST=smtp.example.com
# SMTP portu (genellikle 587 ya da 465)
SMTP_PORT=587
# TLS/SSL kullanan sunucular için true, aksi halde false
SMTP_SECURE=false
# SMTP kullanıcı adı
SMTP_USER=your-smtp-user@example.com
# SMTP şifresi
SMTP_PASS=your-smtp-password

# Mail gönderiminde kullanılan from adresi (opsiyonel, yoksa SMTP_USER kullanılır)
# MAIL_FROM="İK Otomasyon" <no-reply@example.com>

# İK e-posta adresi (hatırlatmaların gönderileceği adres)
HR_EMAIL=ik@example.com
