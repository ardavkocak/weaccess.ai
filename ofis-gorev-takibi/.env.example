# =============================================================================
#  Ofis Görev Takip Sistemi — ortam değişkenleri
# =============================================================================
#  Bu dosyayı `.env` adıyla kopyalayın ve değerleri kendinize göre düzenleyin:
#
#      cp .env.example .env
#
#  .env dosyası git'e GÖNDERİLMEZ (.gitignore içindedir).
# =============================================================================


# --- Sunucu -------------------------------------------------------------------

# Panelin çalışacağı port.
PORT=3001

# Saat dilimi. Cron bildirimleri ve "bugün" hesabı bu bölgeye göre yapılır.
TZ=Europe/Istanbul

# SQLite dosyasının yolu (proje köküne göreli). Klasör yoksa otomatik oluşturulur.
DATABASE_FILE=data/ofis.sqlite


# --- Yönetici girişi ----------------------------------------------------------
#  Sisteme yalnızca admin giriş yapar; çalışanların hesabı yoktur.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123


# --- Oturum -------------------------------------------------------------------

# Oturum çerezlerini imzalayan gizli anahtar. ÜRETİMDE MUTLAKA DEĞİŞTİRİN.
# Rastgele bir değer üretmek için:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=lutfen-bu-degeri-rastgele-bir-sey-ile-degistirin

# Uygulama HTTPS arkasında çalışıyorsa true yapın (çerez yalnızca HTTPS'te gider).
SESSION_SECURE=false


# --- Kayıt (log) --------------------------------------------------------------

# Kayıt seviyesi: debug | info | warn | error
LOG_LEVEL=info

# Tanımlanırsa kayıtlar hem konsola hem bu dosyaya yazılır. Boş = yalnızca konsol.
# LOG_FILE=logs/app.log


# --- Başlangıç ayarları -------------------------------------------------------
#  Aşağıdakiler YALNIZCA ilk çalıştırmada veritabanına yazılır.
#  Sonrasında panelin "Ayarlar" sayfasından değiştirilir; bu dosyayı düzenlemek
#  mevcut ayarları DEĞİŞTİRMEZ.

# Discord bot token'ı. Boş bırakabilirsiniz; panelden de girebilirsiniz.
# Alma adımları için README.md → "Discord Bot Kurulumu" bölümüne bakın.
DISCORD_BOT_TOKEN=

# Ofis Discord sunucunuzun (guild) ID'si. İsteğe bağlı ama önerilir:
# girilirse kanal bu sunucu içinde aranır ve hatalar daha net bildirilir.
DISCORD_GUILD_ID=

# Mesajların gönderileceği kanalın ID'si.
# (Geliştirici Modu → kanala sağ tık → "Kanal ID'sini Kopyala")
DISCORD_CHANNEL_ID=

# Panelde ve mesajlarda görünecek şirket adı.
COMPANY_NAME=Şirketiniz


# --- Otomatik mesaj saatleri --------------------------------------------------
#  Yalnızca ilk kurulumda kullanılır. Sonrasında Ayarlar sayfasından
#  değiştirilir ve zamanlayıcı anında yenilenir.

# Sabah görev bildirimi. Bu mesaj gönderildikten SONRA sıra bir sonraki
# aktif çalışana geçer.
NOTIFY_TIME=08:05

# Birinci çay kontrol hatırlatması (sırayı etkilemez).
TEA_CHECK_1_TIME=10:30

# İkinci çay kontrol hatırlatması (sırayı etkilemez).
TEA_CHECK_2_TIME=15:00

# Gün sonu hatırlatması: çöp + bulaşık makinesi (sırayı etkilemez).
END_OF_DAY_TIME=17:20

# ── Yemek Menüsü modülü ──
# Yarının yemek menüsünün Discord'a duyurulacağı saat. Yalnızca ilk kurulumda
# tohum değeridir; sonrasında Yemek Menüsü sayfasından yönetilir.
# Yarının menüsü veritabanında yoksa hiçbir mesaj gönderilmez.
MEAL_NOTIFY_TIME=15:00

# ── Ayrı Discord kanalları ──
# Görev sistemi ve yemek sistemi aynı botu, FARKLI kanalları kullanır.
# Eski kurulumlardaki tek DISCORD_CHANNEL_ID değeri açılışta her ikisine de
# kopyalanır; sonrasında panelden ayrıştırılır.
DISCORD_DUTY_CHANNEL_ID=
DISCORD_MEAL_CHANNEL_ID=
