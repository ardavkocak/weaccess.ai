<%- include('../partials/layout-start') %>

<% if (formErrors.length > 0) { %>
  <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3">
    <ul class="space-y-1 text-sm text-rose-700">
      <% formErrors.forEach((error) => { %>
        <li>• <%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<!-- Discord yapılandırılmamışsa duyuru gönderilemez; kullanıcı en başta görsün. -->
<% if (!tokenIsSet || !channelIsSet) { %>
  <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
    Menü yükleyebilirsiniz ancak Discord duyurusu için
    <a href="/ayarlar" class="font-semibold underline">Ayarlar</a> sayfasından
    <%= !tokenIsSet ? 'bot token' : 'Yemek Kanalı ID' %> tanımlanmalıdır.
  </div>
<% } %>

<!--
  ================= KATILIM ÖZETİ =================
  Kartlar Discord'da butona basıldıkça canlı tazelenir: sayfadaki JS
  /yemek-menusu/katilim.json uç noktasını yoklar ve data-katilim-* alanlarını
  günceller. Sunucu tarafında basılan değerler ilk açılışın doğru görünmesini
  sağlar; JS kapalıysa sayfa yenilendiğinde yine güncel gelir.
-->
<div class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <p class="text-xs font-medium text-slate-500">🍽️ Toplam Personel</p>
    <p class="mt-1 text-2xl font-bold text-slate-900" data-katilim="total"><%= participation.counts.total %></p>
  </div>
  <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm">
    <p class="text-xs font-medium text-emerald-700">✅ Yiyeceğim</p>
    <p class="mt-1 text-2xl font-bold text-emerald-700" data-katilim="yes"><%= participation.counts.yes %></p>
  </div>
  <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 shadow-sm">
    <p class="text-xs font-medium text-rose-700">❌ Yemeyeceğim</p>
    <p class="mt-1 text-2xl font-bold text-rose-700" data-katilim="no"><%= participation.counts.no %></p>
  </div>
  <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
    <p class="text-xs font-medium text-amber-700">⏳ Cevap Vermeyen</p>
    <p class="mt-1 text-2xl font-bold text-amber-700" data-katilim="pending"><%= participation.counts.pending %></p>
  </div>
</div>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

  <!-- ======================= SOL SÜTUN ======================= -->
  <div class="space-y-5 lg:col-span-2">

    <!-- ---------- Excel yükleme ---------- -->
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold text-slate-900">Aylık Menüyü Yükle</h2>
        <p class="mt-0.5 text-xs text-slate-500">
          Excel dosyası yalnızca yükleme sırasında okunur; veriler veritabanına aktarılır ve
          sistem bundan sonra hep veritabanını kullanır.
        </p>
      </div>

      <form method="POST" action="/yemek-menusu/yukle" enctype="multipart/form-data" class="p-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label for="file" class="mb-1.5 block text-xs font-medium text-slate-700">
          Excel dosyası (.xlsx) <span class="text-rose-500">*</span>
        </label>
        <input type="file" id="file" name="file" accept=".xlsx" required
               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition file:mr-3 file:rounded-md file:border-0 file:bg-slate-900 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white hover:file:bg-slate-700 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">

        <p class="mt-1.5 text-[11px] leading-relaxed text-slate-500">
          En fazla <%= maxFileSizeMb %> MB. Dosyada bir <span class="font-medium">Tarih</span> sütunu ve
          yemekleri içeren bir ya da daha fazla sütun bulunmalıdır. Sütun başlıkları serbesttir
          (<span class="font-mono">Menü</span>, <span class="font-mono">Çorba</span>,
          <span class="font-mono">Ana Yemek</span>…); sistem başlıkları kendisi tanır.
          İsteğe bağlı <span class="font-medium">Gün</span> sütunu da okunur.
        </p>

        <label class="mt-3 flex cursor-pointer items-start gap-2 text-xs text-slate-600">
          <input type="checkbox" name="replace_all"
                 class="mt-0.5 h-3.5 w-3.5 rounded border-slate-300 text-brand-600 focus:ring-brand-500">
          <span>
            <span class="font-medium">Mevcut tüm menüleri sil ve yalnızca bu dosyayı kullan.</span><br>
            İşaretlenmezse aynı tarihler güncellenir, yeni tarihler eklenir (ay ortası düzeltmeleri için).
          </span>
        </label>

        <button type="submit"
                class="mt-4 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Yükle
        </button>
      </form>

      <!-- Son yükleme raporu: hangi sütunlar neye eşlendi? -->
      <% if (importReport) { %>
        <div class="border-t border-slate-100 bg-slate-50/60 px-5 py-4">
          <p class="text-xs font-semibold text-slate-900">Son yükleme raporu</p>
          <dl class="mt-2 grid grid-cols-1 gap-x-6 gap-y-1 text-[11px] text-slate-600 sm:grid-cols-2">
            <div class="flex justify-between gap-2"><dt>Dosya</dt><dd class="font-medium text-slate-800"><%= importReport.fileName %></dd></div>
            <div class="flex justify-between gap-2"><dt>Sayfa</dt><dd class="font-medium text-slate-800"><%= importReport.sheetName %></dd></div>
            <div class="flex justify-between gap-2"><dt>Okunan gün</dt><dd class="font-medium text-slate-800"><%= importReport.rowCount %></dd></div>
            <div class="flex justify-between gap-2"><dt>Atlanan gün</dt><dd class="font-medium text-slate-800"><%= importReport.skipped %></dd></div>

            <!-- Biçime özgü ayrıntılar; parser hazır etiket-değer listesi üretir. -->
            <% importReport.details.forEach((detail) => { %>
              <div class="flex justify-between gap-2">
                <dt><%= detail.label %></dt>
                <dd class="text-right font-medium text-slate-800"><%= detail.value %></dd>
              </div>
            <% }); %>
          </dl>

          <% if (importReport.warnings.length > 0) { %>
            <ul class="mt-2 space-y-0.5 text-[11px] text-amber-700">
              <% importReport.warnings.forEach((warning) => { %>
                <li>⚠ <%= warning %></li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      <% } %>
    </section>

    <!-- ---------- Mevcut menü ---------- -->
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Mevcut Menü</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            <%= summary.upcoming %> yaklaşan gün listeleniyor (toplam <%= summary.total %> kayıt).
          </p>
        </div>

        <% if (summary.total > 0) { %>
          <form method="POST" action="/yemek-menusu/sil"
                data-confirm="Kayıtlı TÜM yemek menüsü silinecek. Bu işlem geri alınamaz. Onaylıyor musunuz?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              Menüyü Sil
            </button>
          </form>
        <% } %>
      </div>

      <% if (menus.length === 0) { %>
        <div class="px-5 py-12 text-center">
          <p class="text-sm font-medium text-slate-900">Kayıtlı menü yok</p>
          <p class="mt-1 text-xs text-slate-500">Yukarıdan aylık Excel dosyasını yükleyin.</p>
        </div>
      <% } else { %>
        <ul class="divide-y divide-slate-100">
          <% menus.forEach((menu) => { %>
            <li class="flex items-start justify-between gap-4 px-5 py-3.5 <%= menu.menu_date === tomorrowDate ? 'bg-brand-50/50' : '' %>">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="text-sm font-semibold text-slate-900"><%= menu.dateLong %></p>
                  <% if (menu.menu_date === tomorrowDate) { %>
                    <span class="rounded-full bg-brand-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-brand-700">Yarın</span>
                  <% } %>
                  <% if (menu.isAnnounced) { %>
                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700">duyuruldu</span>
                  <% } %>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-slate-600"><%= menu.items.map((item) => item.name).join(' · ') %></p>
              </div>

              <form method="POST" action="/yemek-menusu/<%= menu.menu_date %>/sil" class="shrink-0"
                    data-confirm="<%= menu.dateLong %> menüsü silinecek. Onaylıyor musunuz?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" title="Bu günü sil"
                        class="rounded p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </div>

  <!-- ======================= SAĞ SÜTUN ======================= -->
  <div class="space-y-5">

    <!-- ---------- Yarının menüsü ---------- -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">Sıradaki Menü</h2>
      <p class="mt-0.5 text-xs text-slate-500"><%= tomorrowLong %></p>

      <% if (!tomorrow) { %>
        <div class="mt-3 rounded-lg bg-slate-50 px-3 py-3 text-xs text-slate-600 ring-1 ring-slate-200">
          Sıradaki iş günü için menü kaydı yok. Bu durumda saat <%= notifyTime %>'te
          <span class="font-medium">hiçbir mesaj gönderilmez</span>; log'a yalnızca bilgi satırı yazılır.
        </div>
      <% } else { %>
        <ul class="mt-3 space-y-1">
          <% tomorrow.items.forEach((item) => { %>
            <li class="text-sm text-slate-700">
              • <%= item.name %><% if (item.kcal != null) { %> <span class="text-xs text-slate-400">(<%= item.kcal %> kcal)</span><% } %>
            </li>
          <% }); %>
        </ul>

        <form method="POST" action="/yemek-menusu/oylari-sifirla" class="mt-3"
              data-confirm="Yarının tüm oyları silinecek. Onaylıyor musunuz?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="date" value="<%= tomorrowDate %>">
          <button type="submit" class="text-[11px] font-medium text-slate-500 underline transition hover:text-rose-600">
            Oyları sıfırla
          </button>
        </form>
      <% } %>

      <!-- Test gönderimi: cron saatini beklemeden duyurur. -->
      <form method="POST" action="/yemek-menusu/gonder" class="mt-4"
            data-confirm="Yarının menüsü Discord kanalına şimdi gönderilecek. Onaylıyor musunuz?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-40"
                <%= tokenIsSet ? '' : 'disabled title="Önce Discord bot token girin."' %>>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          Sıradaki Menüyü Şimdi Gönder
        </button>
        <p class="mt-1.5 text-[11px] text-slate-500">
          Yalnızca test içindir; "zaten duyuruldu" kontrolünü atlar.
        </p>
      </form>
    </section>

    <!--
      ---------- Katılım ayrıntısı (yalnızca panelde) ----------
      Discord mesajında isim listesi GÖSTERİLMEZ; ayrıntı buradadır.
      Listeler data-katilim-liste ile işaretlenir ve canlı tazelenir.
    -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-900">Katılım Ayrıntısı</h2>
        <span class="text-[11px] text-slate-400" data-katilim-durum>canlı</span>
      </div>
      <p class="mt-0.5 text-xs text-slate-500"><%= tomorrowLong %></p>

      <%
        // Üç listenin görünümü aynı; yalnızca başlık/renk değişiyor.
        const groups = [
          { key: 'yes',     title: 'Yiyecekler',            icon: '✅', tone: 'text-emerald-700' },
          { key: 'no',      title: 'Yemeyecekler',          icon: '❌', tone: 'text-rose-700' },
          { key: 'pending', title: 'Henüz cevap vermeyenler', icon: '⏳', tone: 'text-amber-700' },
        ];
      %>

      <% groups.forEach((group) => { %>
        <div class="mt-4">
          <p class="text-xs font-semibold <%= group.tone %>">
            <%= group.icon %> <%= group.title %>
            (<span data-katilim="<%= group.key %>"><%= participation.counts[group.key] %></span>)
          </p>

          <ul class="mt-1.5 space-y-0.5" data-katilim-liste="<%= group.key %>">
            <% participation[group.key].forEach((person) => { %>
              <li class="flex items-center gap-1.5 text-[12px] text-slate-700">
                <span class="truncate"><%= person.name %></span>
                <% if (person.isExternal) { %>
                  <span class="shrink-0 rounded bg-slate-100 px-1 text-[10px] text-slate-500">personel listesinde yok</span>
                <% } %>
                <% if (person.hasNoDiscordId) { %>
                  <span class="shrink-0 rounded bg-amber-100 px-1 text-[10px] text-amber-700">Discord ID yok</span>
                <% } %>
              </li>
            <% }); %>
            <% if (participation[group.key].length === 0) { %>
              <li class="text-[12px] text-slate-400">—</li>
            <% } %>
          </ul>
        </div>
      <% }); %>
    </section>

    <!-- ---------- Duyuru saati ---------- -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">Duyuru Saati</h2>
      <p class="mt-0.5 text-xs text-slate-500">
        Her gün bu saatte yarının menüsü kanala gönderilir.
      </p>

      <form method="POST" action="/yemek-menusu/saat" class="mt-3 flex items-end gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="flex-1">
          <label for="meal_notify_time" class="mb-1.5 block text-xs font-medium text-slate-700">Saat</label>
          <input type="time" id="meal_notify_time" name="meal_notify_time" required value="<%= notifyTime %>"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
        </div>
        <button type="submit"
                class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700">
          Kaydet
        </button>
      </form>

      <div class="mt-3 space-y-1.5 border-t border-slate-100 pt-3 text-xs">
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Durum</span>
          <span class="font-medium <%= schedulerStatus.active ? 'text-emerald-600' : 'text-rose-600' %>">
            <%= schedulerStatus.active ? '● zamanlandı' : 'kapalı' %>
          </span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Saat dilimi</span>
          <span class="font-medium text-slate-900"><%= schedulerStatus.timezone %></span>
        </div>
        <% if (schedulerStatus.lastRun) { %>
          <div class="border-t border-slate-100 pt-2">
            <p class="text-slate-500">Son çalışma</p>
            <p class="mt-0.5 <%= schedulerStatus.lastRun.ok ? 'text-slate-700' : 'text-rose-600' %>">
              <%= schedulerStatus.lastRun.message %>
            </p>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ---------- Yükleme özeti ---------- -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-semibold text-slate-900">Kayıt Özeti</h2>

      <dl class="mt-3 space-y-2 text-xs">
        <div class="flex items-center justify-between">
          <dt class="text-slate-500">Toplam gün</dt>
          <dd class="font-medium text-slate-900"><%= summary.total %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-500">Yaklaşan gün</dt>
          <dd class="font-medium text-slate-900"><%= summary.upcoming %></dd>
        </div>
        <% if (summary.firstDate) { %>
          <div class="flex items-center justify-between gap-2">
            <dt class="text-slate-500">Aralık</dt>
            <dd class="text-right font-medium text-slate-900"><%= summary.firstDateLong %> – <%= summary.lastDateLong %></dd>
          </div>
        <% } %>
        <% if (summary.sourceFile) { %>
          <div class="flex items-center justify-between gap-2">
            <dt class="shrink-0 text-slate-500">Kaynak dosya</dt>
            <dd class="truncate font-mono text-[11px] text-slate-700" title="<%= summary.sourceFile %>"><%= summary.sourceFile %></dd>
          </div>
        <% } %>
        <div class="flex items-center justify-between gap-2 border-t border-slate-100 pt-2">
          <dt class="text-slate-500">Son güncelleme</dt>
          <dd class="font-medium text-slate-900"><%= summary.lastUpdated || '—' %></dd>
        </div>
      </dl>
    </section>
  </div>
</div>

<!--
  ================= CANLI KATILIM =================
  Discord'da butona basıldığında panelin de güncellenmesi gerekiyor. Sunucudan
  tarayıcıya itme (WebSocket/SSE) kurmak yerine basit yoklama kullanılıyor:
  tek bir JSON isteği, sayfa yenilenmeden kartları ve listeleri tazeliyor.

  Sekme arka plandayken yoklama durur (gereksiz istek atılmaz), sekmeye geri
  dönüldüğünde anında bir kez çalışır.
-->
<script>
  (function () {
    'use strict';

    var ARALIK_MS = 10000;
    var url = '/yemek-menusu/katilim.json?tarih=<%= tomorrowDate %>';
    var durum = document.querySelector('[data-katilim-durum]');
    var zamanlayici = null;

    /** Bir kişiyi liste satırına çevirir (sunucudaki EJS ile aynı görünüm). */
    function satir(kisi) {
      var li = document.createElement('li');
      li.className = 'flex items-center gap-1.5 text-[12px] text-slate-700';

      var ad = document.createElement('span');
      ad.className = 'truncate';
      ad.textContent = kisi.name;          // textContent: HTML enjeksiyonu olmaz
      li.appendChild(ad);

      if (kisi.isExternal) li.appendChild(etiket('personel listesinde yok', 'bg-slate-100 text-slate-500'));
      if (kisi.hasNoDiscordId) li.appendChild(etiket('Discord ID yok', 'bg-amber-100 text-amber-700'));

      return li;
    }

    function etiket(metin, renk) {
      var span = document.createElement('span');
      span.className = 'shrink-0 rounded px-1 text-[10px] ' + renk;
      span.textContent = metin;
      return span;
    }

    function bosSatir() {
      var li = document.createElement('li');
      li.className = 'text-[12px] text-slate-400';
      li.textContent = '—';
      return li;
    }

    function uygula(veri) {
      // Kartlar ve liste başlıklarındaki sayılar (aynı data-katilim adı).
      ['total', 'yes', 'no', 'pending'].forEach(function (anahtar) {
        document.querySelectorAll('[data-katilim="' + anahtar + '"]').forEach(function (el) {
          el.textContent = veri.counts[anahtar];
        });
      });

      ['yes', 'no', 'pending'].forEach(function (anahtar) {
        var liste = document.querySelector('[data-katilim-liste="' + anahtar + '"]');
        if (!liste) return;
        liste.replaceChildren();
        if (veri[anahtar].length === 0) {
          liste.appendChild(bosSatir());
          return;
        }
        veri[anahtar].forEach(function (kisi) { liste.appendChild(satir(kisi)); });
      });

      if (durum) durum.textContent = 'canlı · ' + new Date().toLocaleTimeString('tr-TR');
    }

    function yokla() {
      fetch(url, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (veri) { if (veri) uygula(veri); })
        .catch(function () {
          // Ağ hatası panelin geri kalanını etkilemesin; bir sonraki turda yeniden denenir.
          if (durum) durum.textContent = 'bağlantı yok';
        });
    }

    function basla() {
      if (zamanlayici) return;
      zamanlayici = setInterval(yokla, ARALIK_MS);
    }

    function dur() {
      clearInterval(zamanlayici);
      zamanlayici = null;
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { dur(); return; }
      yokla();
      basla();
    });

    basla();
  })();
</script>

