<%- include('../partials/layout-start') %>

<!-- ================= FİLTRELER ================= -->
<form method="GET" action="/gorev-gecmisi"
      class="mb-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

    <% if (dutyTypes.length > 1) { %>
      <div>
        <label for="tur" class="mb-1.5 block text-xs font-medium text-slate-700">Görev Türü</label>
        <select id="tur" name="tur"
                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
          <option value="">Tümü</option>
          <% dutyTypes.forEach((type) => { %>
            <option value="<%= type.id %>" <%= filters.dutyTypeId === type.id ? 'selected' : '' %>>
              <%= type.emoji %> <%= type.name %>
            </option>
          <% }); %>
        </select>
      </div>
    <% } %>

    <div>
      <label for="baslangic" class="mb-1.5 block text-xs font-medium text-slate-700">Başlangıç</label>
      <input type="date" id="baslangic" name="baslangic" value="<%= filters.from || '' %>"
             class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
    </div>

    <div>
      <label for="bitis" class="mb-1.5 block text-xs font-medium text-slate-700">Bitiş</label>
      <input type="date" id="bitis" name="bitis" value="<%= filters.to || '' %>"
             class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20">
    </div>

    <div class="flex items-end gap-2">
      <button type="submit"
              class="flex-1 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800">
        Filtrele
      </button>
      <a href="/gorev-gecmisi"
         class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-50">
        Temizle
      </a>
    </div>
  </div>
</form>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

  <!-- ================= GEÇMİŞ LİSTESİ ================= -->
  <div class="lg:col-span-2">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold text-slate-900">Görev Geçmişi</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
          <%= history.total %> kayıt
        </span>
      </div>

      <% if (history.rows.length === 0) { %>
        <div class="px-5 py-16 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <p class="mt-3 text-sm font-medium text-slate-900">Kayıt bulunamadı</p>
          <p class="mt-1 text-xs text-slate-500">
            Görev kayıtları her sabah bildirim gönderildiğinde otomatik oluşur.
          </p>
        </div>
      <% } else { %>
        <ul class="divide-y divide-slate-100">
          <% history.rows.forEach((record) => { %>
            <li class="flex items-center gap-3 px-4 py-3.5 sm:px-5 <%= record.isToday ? 'bg-brand-50/60' : '' %>">

              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= avatarColor(record.employee_name) %> text-[11px] font-bold text-white">
                <%= initials(record.employee_name) %>
              </div>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="truncate text-sm font-medium text-slate-800"><%= record.employee_name %></p>
                  <% if (record.isToday) { %>
                    <span class="shrink-0 rounded-full bg-brand-600 px-2 py-0.5 text-[10px] font-bold uppercase text-white">Bugün</span>
                  <% } %>
                  <% if (!record.employee_id) { %>
                    <span class="shrink-0 rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-medium text-slate-500" title="Çalışan sistemden silinmiş">Silinmiş çalışan</span>
                  <% } %>
                </div>
                <p class="mt-0.5 text-xs text-slate-500">
                  <%= record.dateLong %>
                </p>
              </div>

              <div class="flex shrink-0 items-center gap-2">
                <span class="hidden rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-600 sm:inline">
                  <%= record.duty_emoji %> <%= record.duty_name %>
                </span>

                <!-- Sıranın sahibi ofiste değildi, görevi onun yerine bu kişi yaptı -->
                <% if (record.isStandIn) { %>
                  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-700"
                        title="Sıranın sahibi ofiste olmadığı için görevi bu kişi üstlendi; sıra ilerlemedi">Vekaleten</span>
                <% } %>

                <!-- Kaynak: cron mu, admin müdahalesi mi -->
                <% if (record.source === 'manual') { %>
                  <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-medium text-violet-700" title="Admin tarafından elle değiştirildi">Manuel</span>
                <% } %>

                <!-- Bildirim durumu -->
                <% if (record.notified) { %>
                  <span class="text-emerald-500" title="Discord mesajı gönderildi">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  </span>
                <% } else { %>
                  <span class="text-rose-400" title="Discord mesajı gönderilemedi">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19h13.86a2 2 0 001.71-3.03L13.71 4.03a2 2 0 00-3.42 0L3.36 15.97A2 2 0 005.07 19z"/></svg>
                  </span>
                <% } %>
              </div>
            </li>
          <% }); %>
        </ul>

        <!-- Sayfalama -->
        <% if (history.totalPages > 1) { %>
          <div class="flex items-center justify-between border-t border-slate-200 px-5 py-3">
            <p class="text-xs text-slate-500">
              Sayfa <%= history.page %> / <%= history.totalPages %>
            </p>
            <div class="flex gap-1.5">
              <% if (history.page > 1) { %>
                <a href="/gorev-gecmisi?sayfa=<%= history.page - 1 %><%= queryString %>"
                   class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50">
                  ← Önceki
                </a>
              <% } %>
              <% if (history.page < history.totalPages) { %>
                <a href="/gorev-gecmisi?sayfa=<%= history.page + 1 %><%= queryString %>"
                   class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 transition hover:bg-slate-50">
                  Sonraki →
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- ================= KİŞİ BAZLI ÖZET ================= -->
  <div class="lg:col-span-1">
    <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="text-sm font-semibold text-slate-900">Kişi Bazlı Dağılım</h2>
        <p class="mt-0.5 text-xs text-slate-500">Kim kaç kez görev yaptı?</p>
      </div>

      <% if (stats.length === 0) { %>
        <p class="px-5 py-10 text-center text-xs text-slate-500">Henüz veri yok.</p>
      <% } else { %>
        <%
          // En yüksek sayıyı referans alıp oransal çubuk çiziyoruz.
          const maxCount = Math.max(...stats.map((s) => s.duty_count));
        %>
        <ul class="space-y-3 p-5">
          <% stats.forEach((stat) => { %>
            <li>
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="min-w-0 truncate font-medium text-slate-700"><%= stat.employee_name %></span>
                <span class="shrink-0 font-semibold text-slate-900"><%= stat.duty_count %></span>
              </div>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-slate-100">
                <div class="h-full rounded-full bg-brand-500" style="width: <%= (stat.duty_count / maxCount) * 100 %>%"></div>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/layout-end') %>
