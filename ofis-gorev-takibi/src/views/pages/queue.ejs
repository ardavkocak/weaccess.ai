<%- include('../partials/layout-start') %>

<% if (!dutyType) { %>
  <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-800">
    Tanımlı görev türü yok. Sunucuyu yeniden başlatmak varsayılan "Çay" görevini oluşturur.
  </div>
<% } else { %>

  <!-- Görev türü sekmeleri (birden fazla tür tanımlıysa görünür) -->
  <% if (dutyTypes.length > 1) { %>
    <div class="mb-5 flex flex-wrap gap-2">
      <% dutyTypes.forEach((type) => { %>
        <a href="/gorev-sirasi?tur=<%= type.id %>"
           class="rounded-lg px-3.5 py-2 text-sm font-medium transition <%= type.id === dutyType.id ? 'bg-brand-600 text-white shadow-sm' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50' %>">
          <%= type.emoji %> <%= type.name %>
        </a>
      <% }); %>
    </div>
  <% } %>

  <!-- Özet şerit -->
  <div class="mb-5 flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap items-center gap-6">
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Bugün</p>
        <p class="mt-1 text-lg font-semibold text-slate-900">
          <%= overview.todayName || '—' %>
        </p>
      </div>
      <div class="hidden h-10 w-px bg-slate-200 sm:block"></div>
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Sıradaki</p>
        <p class="mt-1 text-lg font-semibold text-slate-900">
          <%= overview.next ? overview.next.full_name : '—' %>
        </p>
        <% if (overview.isStandIn) { %>
          <%# Bugünkü görevi vekaleten biri yaptı; sıranın sahibi hakkını korudu. %>
          <p class="mt-0.5 text-xs text-amber-600">Bugünkü görev vekaleten yapıldı, sıra korundu.</p>
        <% } %>
      </div>
      <div class="hidden h-10 w-px bg-slate-200 sm:block"></div>
      <div>
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Aktif / Toplam</p>
        <p class="mt-1 text-lg font-semibold text-slate-900">
          <%= counts.active %> / <%= counts.total %>
        </p>
      </div>
    </div>

    <form method="POST" action="/gorev/<%= dutyType.id %>/sirayi-gec" class="shrink-0"
          data-confirm="Bugünkü görev sıradaki aktif çalışana devredilecek. Devreden kişi sırasını kaybetmez. Onaylıyor musunuz?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="redirectTo" value="/gorev-sirasi?tur=<%= dutyType.id %>">
      <button type="submit"
              class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto"
              <%= counts.active < 2 ? 'disabled title="Sıra geçmek için en az 2 aktif çalışan gerekir."' : '' %>>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
        Sırayı Geç
      </button>
    </form>
  </div>

  <!-- Sıra listesi -->
  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <div>
        <h2 class="text-sm font-semibold text-slate-900"><%= dutyType.emoji %> <%= dutyType.name %> Görev Sırası</h2>
        <p class="mt-0.5 text-xs text-slate-500">Sıra yukarıdan aşağıya işler, sonuna gelince başa döner. Pasif çalışanlar atlanır.</p>
      </div>
      <a href="/personeller" class="hidden text-xs font-medium text-brand-600 hover:text-brand-700 sm:block">Personel ekle →</a>
    </div>

    <%# Sürükle-bırak yalnızca JavaScript varken görünür; kapalıysa satırlardaki
        ok butonları ve sıra numarası kutusu aynı işi yapmaya devam eder. %>
    <div id="reorder-bar" class="hidden items-center justify-between gap-3 border-b border-slate-200 bg-slate-50 px-5 py-3">
      <p class="text-xs text-slate-600">
        <span class="font-medium text-slate-800">Sıralamayı düzenle:</span>
        satırları tutamaçtan sürükleyip bırakın ya da sıra numarasını değiştirin.
      </p>
      <form method="POST" action="/gorev-sirasi/siralama" id="reorder-form" class="shrink-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="redirectTo" value="/gorev-sirasi?tur=<%= dutyType.id %>">
        <input type="hidden" name="order" id="reorder-input" value="">
        <button type="submit" id="reorder-save" disabled
                class="rounded-lg bg-brand-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300">
          Sıralamayı Kaydet
        </button>
      </form>
    </div>

    <% if (overview.queue.length === 0) { %>
      <div class="px-5 py-16 text-center">
        <p class="text-sm font-medium text-slate-900">Sıra boş</p>
        <p class="mt-1 text-xs text-slate-500">
          <a href="/personeller" class="font-medium text-brand-600 hover:underline">Personeller</a>
          sayfasından çalışan ekleyin.
        </p>
      </div>
    <% } else { %>
      <ul class="divide-y divide-slate-100" id="queue-list">
        <% overview.queue.forEach((employee, index) => { %>
          <li class="queue-row flex items-center gap-3 px-4 py-3 sm:px-5 <%= employee.isToday ? 'bg-brand-50/60' : '' %> <%= employee.is_active ? '' : 'opacity-60' %>"
              data-employee-id="<%= employee.id %>">

            <%# Sürükleme tutamacı — JavaScript etkinleştirir. %>
            <button type="button" class="drag-handle hidden shrink-0 cursor-grab touch-none rounded-md p-1 text-slate-300 transition hover:bg-slate-100 hover:text-slate-500 active:cursor-grabbing"
                    aria-label="<%= employee.full_name %> — sürükleyerek taşı" title="Sürükleyerek taşı">
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7 4a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm9-12a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>
            </button>

            <span class="queue-rank w-6 shrink-0 text-center text-xs font-semibold text-slate-400"><%= index + 1 %></span>

            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= employee.is_active ? avatarColor(employee.full_name) : 'bg-slate-300' %> text-[11px] font-bold text-white">
              <%= initials(employee.full_name) %>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <p class="truncate text-sm font-medium text-slate-800"><%= employee.full_name %></p>

                <% if (employee.isToday) { %>
                  <span class="shrink-0 rounded-full bg-brand-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Bugün</span>
                <% } else if (employee.isNext) { %>
                  <span class="shrink-0 rounded-full bg-slate-800 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Sıradaki</span>
                <% } %>

                <% if (!employee.is_active) { %>
                  <span class="shrink-0 rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-medium text-slate-600">Pasif · atlanır</span>
                <% } %>
              </div>
              <% if (employee.discord_user_id) { %>
                <p class="mt-0.5 truncate font-mono text-[11px] text-slate-400"><%= employee.discord_user_id %></p>
              <% } else { %>
                <p class="mt-0.5 text-[11px] text-slate-400">Discord ID yok · mesajda etiketlenmez</p>
              <% } %>
            </div>

            <!-- Sıra numarasıyla taşı: "3" yazıp Enter → 3. sıraya gider -->
            <form method="POST" action="/personeller/<%= employee.id %>/sira" class="shrink-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="redirectTo" value="/gorev-sirasi?tur=<%= dutyType.id %>">
              <label class="sr-only" for="pos-<%= employee.id %>"><%= employee.full_name %> sıra numarası</label>
              <input type="number" id="pos-<%= employee.id %>" name="position"
                     value="<%= index + 1 %>" min="1" max="<%= overview.queue.length %>"
                     class="queue-position w-14 rounded-md border border-slate-300 px-2 py-1 text-center text-xs outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
                     title="Sıra numarasını değiştirip Enter'a basın">
            </form>

            <!-- Sırada taşı -->
            <div class="flex shrink-0 items-center gap-0.5">
              <form method="POST" action="/personeller/<%= employee.id %>/tasi">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="direction" value="up">
                <input type="hidden" name="redirectTo" value="/gorev-sirasi?tur=<%= dutyType.id %>">
                <button type="submit"
                        class="move-button rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 disabled:opacity-25 disabled:hover:bg-transparent"
                        data-edge="<%= index === 0 ? '1' : '0' %>"
                        <%= index === 0 ? 'disabled' : '' %> title="Yukarı taşı" aria-label="Yukarı taşı">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
                </button>
              </form>
              <form method="POST" action="/personeller/<%= employee.id %>/tasi">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="direction" value="down">
                <input type="hidden" name="redirectTo" value="/gorev-sirasi?tur=<%= dutyType.id %>">
                <button type="submit"
                        class="move-button rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 disabled:opacity-25 disabled:hover:bg-transparent"
                        data-edge="<%= index === overview.queue.length - 1 ? '1' : '0' %>"
                        <%= index === overview.queue.length - 1 ? 'disabled' : '' %> title="Aşağı taşı" aria-label="Aşağı taşı">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                </button>
              </form>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <!-- Mesaj şablonu bilgisi -->
  <% if (dutyMessage) { %>
  <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-sm font-semibold text-slate-900">Gönderilecek Mesaj</h3>
      <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-600">
        Her gün <%= dutyMessage.send_time %>
      </span>
    </div>
    <p class="mt-1 text-xs text-slate-500">
      Bu mesajla Discord'da onay akışı başlar; sıra ancak görevi yapan kişi onaylandığında ilerler.
      Saatini <a href="/ayarlar" class="font-medium text-brand-600 hover:underline">Ayarlar</a>'dan değiştirebilirsiniz.
    </p>
    <pre class="mt-3 overflow-x-auto whitespace-pre-wrap rounded-lg bg-slate-900 px-4 py-3 text-xs leading-relaxed text-slate-100"><code><%= dutyMessage.message_template %></code></pre>
    <p class="mt-2 text-[11px] text-slate-500">
      Kullanılabilir değişkenler:
      <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{name}</code>,
      <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{mention}</code>,
      <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{emoji}</code>,
      <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{duty}</code>,
      <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{company}</code>,
      <code class="rounded bg-slate-100 px-1 py-0.5 font-mono">{date}</code>
    </p>
  </div>
  <% } %>
<% } %>

<%- include('../partials/layout-end') %>
