<%
  /*
    Sol menü. `activeNav` her controller tarafından gönderilir ve aktif bağlantıyı
    vurgulamak için kullanılır. Menüye yeni sayfa eklemek için bu diziye bir
    nesne eklemek yeterlidir.
  */
  const navItems = [
    { key: 'dashboard', label: 'Dashboard',     href: '/',              icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
    { key: 'employees', label: 'Personeller',   href: '/personeller',   icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
    { key: 'queue',     label: 'Görev Sırası',  href: '/gorev-sirasi',  icon: 'M4 6h16M4 10h16M4 14h16M4 18h16' },
    { key: 'history',   label: 'Görev Geçmişi', href: '/gorev-gecmisi', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
    { key: 'meal',      label: 'Yemek Menüsü',  href: '/yemek-menusu',  icon: 'M3 3v8a3 3 0 003 3v7m0-18v7m3-7v7M18 3c-1.5 2-2 4.5-2 7 0 1.5.5 2 2 2v9' },
    { key: 'settings',  label: 'Ayarlar',       href: '/ayarlar',       icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  ];
%>

<!-- Mobilde menü açıkken arka planı karartan katman -->
<div id="sidebar-overlay"
     class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"
     aria-hidden="true"></div>

<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-slate-900 transition-transform duration-200 ease-out lg:translate-x-0">

  <!-- Logo / şirket adı -->
  <div class="flex h-16 shrink-0 items-center gap-3 border-b border-slate-800 px-5">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-lg">☕</span>
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold text-white"><%= companyName %></p>
      <p class="truncate text-xs text-slate-400">Görev Takip Sistemi</p>
    </div>
  </div>

  <!-- Menü -->
  <nav class="flex-1 space-y-1 overflow-y-auto p-3">
    <% navItems.forEach((item) => { %>
      <%
        const isActive = activeNav === item.key;
        const classes = isActive
          ? 'bg-brand-600 text-white'
          : 'text-slate-300 hover:bg-slate-800 hover:text-white';
      %>
      <a href="<%= item.href %>"
         class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors <%= classes %>"
         <%= isActive ? 'aria-current="page"' : '' %>>
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= item.icon %>" />
        </svg>
        <%= item.label %>
      </a>
    <% }); %>
  </nav>

  <!-- Çıkış -->
  <div class="shrink-0 border-t border-slate-800 p-3">
    <form method="POST" action="/cikis">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit"
              class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800 hover:text-white">
        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        Çıkış Yap
      </button>
    </form>
  </div>
</aside>
