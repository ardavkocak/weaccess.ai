<%- include('head') %>
<%- include('sidebar') %>

<!-- Ana içerik alanı: masaüstünde sabit menü kadar sola boşluk bırakır. -->
<div class="lg:pl-64">

  <!-- Üst çubuk -->
  <header class="sticky top-0 z-20 flex h-16 items-center gap-4 border-b border-slate-200 bg-white/90 px-4 backdrop-blur sm:px-6">
    <!-- Mobil menü açma düğmesi -->
    <button id="sidebar-toggle" type="button"
            class="-ml-1 rounded-lg p-2 text-slate-600 hover:bg-slate-100 lg:hidden"
            aria-label="Menüyü aç" aria-expanded="false" aria-controls="sidebar">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <h1 class="truncate text-base font-semibold text-slate-900 sm:text-lg"><%= pageTitle %></h1>

    <div class="ml-auto hidden items-center gap-2 text-sm text-slate-500 sm:flex">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span><%= new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date()) %></span>
    </div>
  </header>

  <main class="mx-auto max-w-7xl p-4 sm:p-6">
    <%- include('flash') %>
