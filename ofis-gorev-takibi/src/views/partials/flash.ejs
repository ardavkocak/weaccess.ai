<%
  /* İşlem sonucu bildirimleri (bir kez gösterilir). */
  const styles = {
    success: { box: 'bg-emerald-50 border-emerald-200 text-emerald-800', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
    error:   { box: 'bg-rose-50 border-rose-200 text-rose-800',          icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
    info:    { box: 'bg-sky-50 border-sky-200 text-sky-800',             icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  };
%>
<% if (flashMessages && flashMessages.length > 0) { %>
  <div class="mb-5 space-y-2">
    <% flashMessages.forEach((item) => { %>
      <% const style = styles[item.type] || styles.info; %>
      <div class="flash-message flex items-start gap-3 rounded-xl border px-4 py-3 text-sm <%= style.box %>" role="status">
        <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= style.icon %>" />
        </svg>
        <p class="flex-1"><%= item.message %></p>
        <button type="button" class="flash-close shrink-0 opacity-60 hover:opacity-100" aria-label="Kapat">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    <% }); %>
  </div>
<% } %>
