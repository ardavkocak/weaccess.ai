# Discord Developer Portal'dan aldığın bot token'ı
DISCORD_TOKEN=your-bot-token-here

# Google Sheets belge ID'si (sheet URL'sindeki /d/ ile /edit arasındaki kısım)
SPREADSHEET_ID=

# Sheet içindeki sekme adı (görseldeki gibi)
WORKSHEET_NAME=Sales Pipeline

# Google servis hesabı JSON dosyasının yolu (bkz. README kurulum adımları)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# SQLite veritabanı dosya yolu
DB_PATH=data/bot.db

# Varsayılan kontrol sıklığı (dakika) ve eskime eşiği (gün) - /ayar komutlarıyla değiştirilebilir
DEFAULT_POLL_MINUTES=1
DEFAULT_STALE_DAYS=7

# TEST_GUILD_ID doluysa slash komutları sadece bu sunucuya anında senkronize edilir.
TEST_GUILD_ID=
